{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "avatar-bundle.js", "use": "@vercel/static" },
    { "src": "bomb.png", "use": "@vercel/static" },
    { "src": "api/ws.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/ws(?:/)?", "dest": "/api/ws.ts" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
